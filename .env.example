APP_NAME=AgentFlow
APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Docker Compose overrides these URLs inside containers.
DATABASE_URL=sqlite:///./agentflow.db
REDIS_URL=redis://localhost:6379/0

# Optional API protection. Set a strong random value and keep it private.
AGENTFLOW_API_KEY=

# Optional AI workflow planning provider configuration.
GROQ_API_KEY=
AI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_STEPS=10

# Rate limiting.
AGENTFLOW_RATE_LIMIT=120
AGENTFLOW_RATE_WINDOW_SECONDS=60
